import OddZeta.Numerics.Core

/-!
# Precomputed constants (certified by `decide +kernel`)

All constants are stored as natural numbers `v` with `v ≤ 2^256 x ≤ v + 64`:

* `log2T`   : `x = log 2`,
* `halfPiT` : `x = π / 2`,
* `piT`     : `x = π`,
* `logTab`  : packed table of `x = log (1 + j/128)`, `j = 0, …, 128`,
* `atanTab` : packed table of `x = arctan (j/128)`, `j = 0, …, 128`.

The packed tables store entry `j` in bits `[264 j, 264 (j+1))`; see `tabGet`.
Each constant is checked (once, by `decide +kernel`) against the verified
series evaluator `seriesNN` run at precision `2^-256` with enough terms.
-/

namespace OddZeta.Num

/-- Entry `j` of a packed table (`264` bits per entry). -/
def tabGet (tab j : ℕ) : ℕ := (tab >>> (264 * j)) % 2 ^ 264

/-- `≈ 2^256 log 2`. -/
def log2T : ℕ :=
  0xb17217f7d1cf79abc9e3b39803f2f6af40f343267298b62d8a0d175b8baafa2a

/-- `≈ 2^256 π / 2`. -/
def halfPiT : ℕ :=
  0x1921fb54442d18469898cc51701b839a252049c1114cf98e804177d4c7627363e

/-- `≈ 2^256 π`. -/
def piT : ℕ :=
  0x3243f6a8885a308d313198a2e03707344a4093822299f31d0082efa98ec4e6c7c

set_option linter.style.longLine false in
/-- Packed table of `≈ 2^256 log (1 + j/128)`, `0 ≤ j ≤ 128`. -/
def logTab : ℕ :=
  

set_option linter.style.longLine false in
/-- Packed table of `≈ 2^256 arctan (j/128)`, `0 ≤ j ≤ 128`. -/
def atanTab : ℕ :=
  

/-! ### Certificates -/

/-- Verified bounds on `2^256 log (1 + j/128) = 2^257 artanh (j / (256 + j))`. -/
def logTabCert (j : ℕ) : ℕ × ℕ := seriesNN false j (256 + j) 90 257

/-- Verified bounds on `2^256 π/4 = 2^256 (arctan (1/2) + arctan (1/3))`. -/
def quarterPiCert : ℕ × ℕ :=
  let s := seriesNN true 1 2 130 256
  let t := seriesNN true 1 3 90 256
  (s.1 + t.1, s.2 + t.2)

/-- Verified bounds on `2^256 arctan (j/128)`. -/
def atanTabCert (j : ℕ) : ℕ × ℕ :=
  if j ≤ 64 then seriesNN true j 128 130 256
  else
    let s := seriesNN true (128 - j) (128 + j) 90 256
    (quarterPiCert.1 - s.2, quarterPiCert.2 - s.1)

theorem logTab_check : ∀ j < 129,
    tabGet logTab j ≤ (logTabCert j).1 ∧ (logTabCert j).2 ≤ tabGet logTab j + 64 := by
  decide +kernel

theorem atanTab_check : ∀ j < 129,
    tabGet atanTab j ≤ (atanTabCert j).1 ∧ (atanTabCert j).2 ≤ tabGet atanTab j + 64 := by
  decide +kernel

theorem consts_check :
    (log2T ≤ (logTabCert 128).1 ∧ (logTabCert 128).2 ≤ log2T + 64) ∧
    (halfPiT ≤ 2 * quarterPiCert.1 ∧ 2 * quarterPiCert.2 ≤ halfPiT + 64) ∧
    (piT ≤ 4 * quarterPiCert.1 ∧ 4 * quarterPiCert.2 ≤ piT + 64) := by
  decide +kernel

end OddZeta.Num
