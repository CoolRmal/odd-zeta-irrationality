import OddZeta.Numerics.IntervalComplex

/-!
# Tests and kernel benchmark for `OddZeta.Numerics.Interval`

`bench1000` checks, with a single `decide +kernel`, 1000 inequalities
`logHi x 60 ≤ c` / `c ≤ atanLo x 60` with random inputs `x = n/d` (numerators and
denominators up to `10^30`, `|x|` between `10^-30` and `10^30`) and `c` within
`2·10^-16 (1 + |value|)` of the true value (reference values from mpmath).

`bench1000_control` evaluates the same `ℚ` literals and one `ℚ` comparison per line, without
calling the library: the difference of the two kernel times is the cost of the library.

Measured kernel type-checking times (`set_option profiler true`, Apple silicon laptop, while other
Lean jobs were running, so ±20%):
* `bench1000`         : ≈ 1.15 s (≈ 1.15 ms per inequality, all included),
* `bench1000_control` : ≈ 0.8 s  (normalising the `ℚ` literals `n/d` and the decimal `c`, and one
  `Rat.blt` comparison: core `Rat`/`Int` code, whose `Int` operations are slow in the kernel),
so the library itself accounts for ≈ 0.3 ms per evaluation. On already-normalised inputs
(`logCore n d 60`, `atanNN p q 60` on natural numbers) one evaluation costs ≈ 0.16 ms,
plus ≈ 0.04 ms to build the output rational.
-/

namespace OddZeta.Num.Test

open OddZeta.Num

/-! ### Small sanity checks -/

example : 0.6931471805599453 ≤ logLo 2 60 ∧ logHi 2 60 ≤ 0.6931471805599454 := by decide +kernel
example : (3.14159265358979323846264338327950 : ℚ) ≤ piLo ∧
    piHi ≤ (3.14159265358979323846264338327951 : ℚ) := by decide +kernel
example : 2.356194490192344 ≤ argLo (-1) 1 60 ∧ argHi (-1) 1 60 ≤ 2.356194490192345 := by
  decide +kernel
example : -1.570796326794897 ≤ argLo 0 (-5) 60 ∧ argHi 0 (-5) 60 ≤ -1.570796326794896 := by
  decide +kernel
example : 1.6094379124341003 ≤ logAbsLo 3 4 60 ∧ logAbsHi 3 4 60 ≤ 1.6094379124341004 := by
  decide +kernel
example : -0.4636476090008062 ≤ atanLo (-1/2) 60 ∧ atanHi (-1/2) 60 ≤ -0.4636476090008061 := by
  decide +kernel
/-- widths at `prec = 60` are a few units of `2^-60` -/
example : logHi (10 ^ 30) 60 - logLo (10 ^ 30) 60 ≤ 8 / 2 ^ 60 ∧
    atanHi (7 / 3) 60 - atanLo (7 / 3) 60 ≤ 8 / 2 ^ 60 := by decide +kernel

